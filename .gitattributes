# Files that run on Linux (the droplet, Docker) must keep LF line endings even
# when checked out on Windows with core.autocrlf=true — bash fails on CRLF
# ("$'\r': command not found"), and deploy-docker.sh ships the working tree.
*.sh              text eol=lf
Dockerfile        text eol=lf
*.yml             text eol=lf
*.service         text eol=lf
.dockerignore     text eol=lf
